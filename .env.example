# ═══════════════════════════════════════════════════
#  OneMP11 Alert Server — Environment Variables
#  Copy this to .env and fill in your values
# ═══════════════════════════════════════════════════

# Discord webhook URL (from your Discord channel settings)
DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/YOUR_WEBHOOK_ID/YOUR_WEBHOOK_TOKEN

# Anthropic API key (from console.anthropic.com)
ANTHROPIC_API_KEY=sk-ant-api03-xxxxx

# Optional: webhook secret to verify TradingView requests
WEBHOOK_SECRET=onemp11

# Enable/disable Claude analysis (set to false to just forward alerts)
ENABLE_CLAUDE=true

# Database path (Railway provides persistent storage)
DB_PATH=alerts.db
